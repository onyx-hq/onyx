# Secrets: 1password → "ENV oxy local dev". Placeholders below are non-secret hints.

# LLM providers
OPENAI_API_KEY=<check_in_our_1password>
ANTHROPIC_API_KEY=<check_in_our_1password>

# OAuth — Google / Okta
GOOGLE_CLIENT_ID=<check_in_our_1password>
GOOGLE_CLIENT_SECRET=<check_in_our_1password>
OKTA_CLIENT_ID=<check_in_our_1password>
OKTA_CLIENT_SECRET=<check_in_our_1password>
OKTA_DOMAIN=<check_in_our_1password>

# GitHub App (OAuth + API)
GITHUB_APP_ID=<check_in_our_1password>
GITHUB_APP_PRIVATE_KEY=<check_in_our_1password>
GITHUB_APP_SLUG=<check_in_our_1password>
GITHUB_CLIENT_ID=<check_in_our_1password>
GITHUB_CLIENT_SECRET=<check_in_our_1password>
GITHUB_STATE_SECRET=<check_in_our_1password>

# Slack (shared multi-tenant app)
OXY_SLACK_CLIENT_ID=<check_in_our_1password>
OXY_SLACK_CLIENT_SECRET=<check_in_our_1password>
OXY_SLACK_SIGNING_SECRET=<check_in_our_1password>
OXY_SLACK_APP_LEVEL_TOKEN=<check_in_our_1password>
OXY_SLACK_APP_BASE_URL=http://localhost:5173
OXY_SLACK_ENABLED=true
OXY_SLACK_CHART_UPLOAD=true

# Local server URLs. Only OXY_API_URL is read by the server (and by the Slack
# and workspace-health links it builds). `OXY_URL` belongs to the camera EDGE
# container's compose file, not here — see internal-docs/camera-fleet-local-testing.md.
OXY_API_URL=http://localhost:3000/api

# Control-plane Postgres. Usually you do NOT set this: `oxy start` boots the
# oxy-postgres container and points at it, and a dev `oxy serve` falls back to
# an embedded server under ~/.local/share/oxy/postgres_data. Set it to aim at
# something else — a shared dev box, or the Docker one from a bare `oxy serve`:
# OXY_DATABASE_URL=postgresql://postgres:postgres@localhost:15432/oxy

# Platform
# OXY_OWNER = global owner (staff superuser); OXY_GLOBAL_ADMINS = comma-sep is_app_admin
# OXY_OWNER=you@oxy.tech
OXY_GLOBAL_ADMINS=you@oxy.tech

# Dev sign-in bypass — the identities `/dev-login` (and `POST
# /api/auth/dev-login`) will mint a real session for, no OAuth and no
# magic-link email. This is what lets Playwright MCP / any browser-automation
# tool sign in to a local server; see DEVELOPMENT.md.
#
# You usually do NOT set this. On a debug build (`cargo run serve`, `just`) an
# unset value falls back to OXY_GLOBAL_ADMINS above, so a dev box needs no
# configuration. (The pre-rename OXY_APP_ADMINS is no longer read by anything —
# rename it if you still have one.) That inferred list is served to LOOPBACK
# CALLERS ONLY — `serve` binds 0.0.0.0, and a roster nobody typed must not vend
# staff sessions to every device on your wifi. Set this explicitly to serve
# other hosts (containers, a remote dev box), to override the list — or to
# empty, the off switch that leaves the staff roster alone:
#   OXY_DEV_LOGIN_EMAILS=            # bypass off, admins untouched
#   OXY_DEV_LOGIN_EMAILS=dev@oxy.local,member@oxy.local
#
# RELEASE builds (production, and every Docker image) ignore the fallback and
# honor only an explicit value here — deliberately. OXY_GLOBAL_ADMINS IS set on
# real deployments, so a release binary that honored it would hand anyone who
# can reach the server an unauthenticated Global-Admin session. Never set this
# on a deployment other people can reach.
# OXY_DEV_LOGIN_EMAILS=dev@oxy.local

# Bind the Vite dev server beyond loopback — e.g. `true` to test on a phone.
# Loopback by default: the dev server proxies /api to the backend, and a dev
# box holds real cloud credentials. The backend already refuses to vend the
# INFERRED dev-login roster to non-loopback callers (see above), so this is the
# second layer rather than the only one.
# OXY_DEV_HOST=true

# Observability is opt-in and ClickHouse-only — there is no embedded store to
# default to, so leaving this unset disables span capture entirely. To turn it
# on, source .env.clickhouse instead of uncommenting here:
#   oxy start → boots its own oxy-clickhouse container (just dev-backend-obs)
#   oxy serve → needs an external one (just clickhouse-up)
# OXY_OBSERVABILITY_BACKEND=clickhouse
# OXY_CLICKHOUSE_URL=http://localhost:8123
# OXY_CLICKHOUSE_USER=default
# OXY_CLICKHOUSE_PASSWORD=
# OXY_CLICKHOUSE_DATABASE=observability

# Platform telemetry → an OTel collector → ClickStack / HyperDX. This is the
# OPERATOR store (what you debug prod with), unrelated to the product
# observability store above; the two are switched independently. Trace context
# (ids in every JSON log line, traceparent on the serve→ide hop) is always on
# for `serve` / `start` / `worker`; nothing is EXPORTED until the endpoint is
# set. Must be the collector's OTLP/HTTP port (4318), not gRPC (4317).
# `just clickstack-up` boots a local one. Operator guide:
# internal-docs/platform-telemetry.md (incl. what the clusters still need).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT / OTEL_EXPORTER_OTLP_LOGS_ENDPOINT override per signal.
# OTEL_EXPORTER_OTLP_HEADERS=authorization=<hyperdx-ingestion-key>   # HyperDX Cloud only
# OTEL_SERVICE_NAME=oxy            # default: oxy-serve / oxy-ide / oxy-worker by role, else oxy
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
# OTEL_LOGS_EXPORTER=otlp          # OPT-IN: only for a collector that does not tail stdout (local
#                                  # all-in-one, HyperDX Cloud). The clusters' DaemonSet tails
#                                  # stdout, so there this would store every log twice.
# OXY_STDERR_CAPTURE=off           # JSON log format only: stop rewriting stray stderr lines
#                                  # (dependencies, C libs, panics) into JSON. On by default.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2
# OXY_OTEL_FILTER=info             # what is EXPORTED (RUST_LOG syntax); OXY_LOG_LEVEL is what is PRINTED
# OXY_LOG_FORMAT=json              # force the one-JSON-object-per-line stderr format off Kubernetes
OXY_WORKER_MAX_INFLIGHT=8

# Per-org OLTP Postgres. These OXY_OLTP_* vars configure the PROVIDER (where
# tenants are provisioned); unset means no provider and every `oxy oltp` verb
# errors saying so — deliberately, because defaulting to `local` once pointed a
# provisioner at Oxy's OWN control plane.
#
# The runtime KILL-SWITCH is separate: the `oltp` feature flag (DB-backed, off
# by default), flipped at /admin/feature-flags. Off, provisioning and every
# `postgres_managed` query fail closed fleet-wide with no redeploy. So enabling
# per-org OLTP is two steps — configure a provider here AND flip the flag on.
#
# `oxy start` is the exception, and only for its own process: when you have NOT
# set OXY_OLTP_PROVIDER it points this at the Postgres it just started (local,
# one cluster, a database per org) so a dev box never provisions real Neon
# projects by accident. Setting OXY_OLTP_PROVIDER=neon here opts back out.
# `oxy serve --enterprise` — the other "run it locally" path — does NOT default
# anything, so OLTP is off there unless you set these vars yourself.
#
#   local  — tenant databases on the cluster OXY_OLTP_ADMIN_URL names. What you
#            want for development; nothing is billable and nothing leaves the box.
#   neon   — real Neon projects, really billed. Needs both NEON vars below; a
#            partial config is a startup error, not a silent fallback.
#   mock   — in-memory, for tests.
#
# Docs: scripts/oltp/README.md
# OXY_OLTP_ADMIN_URL is handed straight to CREATE ROLE / CREATE DATABASE, and
# the value below is the same cluster the control plane uses — the dev one, on
# purpose. (The OLTP integration SUITE is the exception: `just oltp-test-db`
# runs a disposable cluster on :15433, off this one.) Never point this at a
# shared or staging box.
# OXY_OLTP_PROVIDER=local
# OXY_OLTP_ADMIN_URL=postgresql://postgres:postgres@localhost:15432/oxy
# OXY_OLTP_NEON_API_KEY=<check_in_our_1password>
# OXY_OLTP_NEON_ORG_ID=org-...

# Feature-flag cache: how often (ms) each instance re-reads the flag table, so a
# flag flipped on one pod (e.g. the `oltp` kill-switch) reaches the rest. Default
# 15000. A positive value is floored at 50ms; 0 or an unparseable value means the
# default (there is no "off" — reads are always cache-served). Mainly a test knob.
# OXY_FEATURE_FLAG_REFRESH_MS=15000

# Workspace-health ops alerts. Both Slack vars must be set or nothing is pushed
# (the admin Health tab still works). Messages link to the workspace's Health tab,
# built from OXY_API_URL. A workspace that stays unhealthy is re-alerted every
# OXY_HEALTH_REALERT_HOURS, and immediately when a dimension starts failing or
# gets worse; 0 disables both (transition-only alerting).
# OXY_OPS_SLACK_BOT_TOKEN=<check_in_our_1password>
# OXY_OPS_SLACK_CHANNEL=C0123456789
# OXY_HEALTH_REALERT_HOURS=6

# (Dev sign-in bypass, OXY_DEV_LOGIN_EMAILS, is documented in the Platform
# section above, next to the OXY_GLOBAL_ADMINS it falls back to.)

# Email — keep both =1/true for local dev (which runs cloud/enterprise mode):
# they open the rendered email in your browser instead of sending. Unset/0 in a
# real deployment to send via SES.
MAGIC_LINK_LOCAL_TEST=true          # magic-link + invitation emails
OXY_APP_EMAIL_LOCAL_TEST=1          # custom-app ctx.email.send
# OXY_APP_EMAIL_FROM=noreply@oxygen-hq.com   # verified SES sender for real cloud sends
# OXY_APP_EMAIL_REGION=us-east-1

# Customer-app asset store (ctx.storage). Unset -> local filesystem under
# OXY_STATE_DIR, which covers put/get/list but NOT presigned upload/download
# (those mint a URL the browser uses, so they need real object storage; point
# AWS_ENDPOINT_URL at a local MinIO to exercise them).
# OXY_CUSTOMER_APPS_STORAGE_S3_BUCKET=<check_in_our_1password>
# OXY_CUSTOMER_APPS_STORAGE_MAX_UPLOAD_BYTES=104857600   # 100 MiB presigned-upload ceiling

# Ceiling a custom-app FUNCTION may declare for its own `ctx.fetch` responses via
# `fetch.maxResponseBytes` in oxy-app.json. Functions default to 10 MiB and must
# opt in per function; this bounds how far any one of them can go, because the
# response is buffered in a process shared by every app on the instance.
# OXY_CUSTOMER_APPS_FETCH_MAX_BYTES=104857600            # 100 MiB

# File-source upload zone (the pipeline page's Reports tab). Unset -> the
# upload endpoint 503s, which is the intended posture: no zone, no uploads.
# A pipeline's `base_path` must equal <zone>/<workspace_id>/<kind>/<pipeline>
# exactly, and the server refuses an upload whose pipeline reads elsewhere.
# OXY_SOURCE_UPLOAD_ZONE=s3://oxy-local-source-uploads
#
# Against a local MinIO, both sides need AWS_* — and they are NOT the same
# client, which is the part that costs an hour:
#
#   upload  (aws-sdk-s3)    AWS_ENDPOINT_URL; forces path-style itself
#   extract (object_store)  the same, PLUS AWS_ALLOW_HTTP=true — it refuses
#                           a plain-http endpoint, and the refusal surfaces
#                           as `list … failed: request failed`, which reads
#                           like bad credentials and is a scheme check
#
# Audit tamper evidence: every hour the singleton writes each org's audit-chain
# head to this bucket under S3 Object Lock (compliance mode). The bucket must be
# created WITH Object Lock enabled (Terraform: object_lock_enabled = true).
# Unset = off. See internal-docs/admin-surfaces.md.
# OXY_AUDIT_ANCHOR_S3_BUCKET=oxy-dev-audit-anchors
# OXY_AUDIT_ANCHOR_KEY_PREFIX=audit-anchors
# OXY_AUDIT_ANCHOR_INTERVAL_SECS=3600
# OXY_AUDIT_ANCHOR_RETENTION_DAYS=400
# AWS_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# AWS_ALLOW_HTTP=true
