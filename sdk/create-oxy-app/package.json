{
  "name": "@oxy-hq/create-oxy-app",
  "version": "0.5.0",
  "description": "Scaffold a new Oxy custom app from a curated template.",
  "type": "module",
  "bin": {
    "create-oxy-app": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxy-hq/oxygen-internal.git",
    "directory": "sdk/create-oxy-app"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "oxy",
    "customer-apps",
    "create",
    "scaffold"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
