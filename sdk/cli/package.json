{
  "name": "@oxy-hq/cli",
  "version": "0.4.0",
  "description": "oxyc — the Oxy CLI: a gh-api-style client for the Oxy HTTP API, plus the customer-account tooling that scopes a session to one customer.",
  "type": "module",
  "bin": {
    "oxyc": "dist/main.mjs"
  },
  "files": [
    "README.md",
    "dist",
    "json-schemas",
    "skills",
    "template"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxy-hq/oxygen-internal.git",
    "directory": "sdk/cli"
  },
  "scripts": {
    "codegen": "node scripts/emit-version.mjs && node scripts/sync-schemas.mjs && node scripts/embed-assets.mjs",
    "prebuild": "pnpm run codegen",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "build:binary": "pnpm run build && node scripts/build-binaries.mjs",
    "lint": "biome check src",
    "prepublishOnly": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "pnpm run codegen",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "oxy",
    "cli",
    "api",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.28 || ^4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
