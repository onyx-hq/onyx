{
  "name": "oxy-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc -b && vite build",
    "compile": "NODE_OPTIONS='--max-old-space-size=8192' tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ts": "pnpm compile",
    "lint:ts:tests": "NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.test.json",
    "preview": "vite preview",
    "format": "biome check --write --diagnostic-level=error .",
    "format:check": "biome check --diagnostic-level=error .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:agentic": "tsx tests/agentic/runner/cli.ts",
    "test:agentic:headed": "HEADED=1 tsx tests/agentic/runner/cli.ts",
    "test:agentic:debug": "DEBUG=1 HEADED=1 tsx tests/agentic/runner/cli.ts",
    "test:unit": "vitest run"
  },
